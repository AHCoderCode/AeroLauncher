<Window x:Class="AeroOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroOS Windows Edition"
        Width="1320" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111D30" />
        <SolidColorBrush x:Key="CardBrush" Color="#17263D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F6FC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A2B2C7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CF6" />
        <SolidColorBrush x:Key="LineBrush" Color="#2A3A52" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="A" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AeroOS" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="WINDOWS EDITION" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="360" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Padding="13,8" FontSize="13" Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"
                         CaretBrush="{DynamicResource AccentBrush}" ToolTip="Search installed Windows Start-menu shortcuts"
                         TextChanged="SearchBox_TextChanged" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Windows Settings" Click="WindowsSettings_Click" Margin="0,0,9,0"
                            Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" />
                    <Button Content="About" Click="About_Click" Background="{DynamicResource CardBrush}"
                            Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,22,14,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,0,0,12" />
                        <Button Content="⌂   Overview" Tag="Home" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                        <Button Content="▦   Applications" Tag="Apps" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                        <Button Content="◈   Personalization" Tag="Personalization" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                        <Button Content="⚙   Control Center" Tag="ControlCenter" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,8,4,14" />
                        <TextBlock Text="SAFE DESKTOP MODE" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="12,0,0,7" />
                        <TextBlock Text="Windows Explorer and the native Windows taskbar remain in control. AeroOS runs as a normal app window." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,0,10,10" />
                        <Button Content="↗   Open File Explorer" Click="OpenExplorer_Click" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="ContentSurface" Grid.Column="1" Background="{DynamicResource WindowBgBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" Margin="34,30,34,36" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock Text="AeroOS Windows Edition  •  Native Windows remains the operating system" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterClock" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
