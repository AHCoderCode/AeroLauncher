<Window x:Class="AeroOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroOS Windows Edition"
        Width="1280" Height="800" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#0A1020"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid x:Name="ShellRoot" ClipToBounds="True" />
</Window>